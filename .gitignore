# --- Pasta privada do projeto (não versionar) ---
naomexer/**

# --- Build local do GitHub Pages (gerado pelo workflow) ---
_site/

# --- react-app: dependências e builds ---
node_modules/
react-app/node_modules/
react-app/dist/
react-app/build/
react-app/.vite/
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Variáveis de ambiente / segredos ---
.env
.env.*
!.env.example

# --- Sistema operacional ---
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
*~
.directory
.Trash-*

